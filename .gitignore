__pycache__/
*.pyc
# CST: сырые экспорты ДН (~5 МБ каждый) и рабочие папки проектов не храним
cst/*/ff_*.txt
cst/*/_ff_tmp.txt
cst/*/mimo_*/
cst/*/build.log
cst/*/export.log
# кольца ringz: проекты CST и большие массивы не храним, только результаты
cst/ringz_*/ringz/
cst/ringz_*/ringz.cst
cst/ringz_*/*.npy
cst/ring_R10/
cst/ringz_*/*.s18p
# конусы build_cone2: проекты CST и прерванные прогоны не храним
cst/cone_*/cone/
cst/cone_*/cone.cst
cst/cone_*_failed*/
cst/tpl_test.docx
cst/cone_fa_d1.5/
